    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "i18next": "26.3.1",
    "react": "19.2.7",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.8",

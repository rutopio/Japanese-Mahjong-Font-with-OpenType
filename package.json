{
  "name": "japanese-mahjong-font-with-openType",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "vite --host",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build": "vite build && tsc -p tsconfig.json",
    "preview": "vite preview",
    "preview:cf": "pnpm build && wrangler pages dev dist",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check-types": "tsc --noEmit && tsc -p functions/tsconfig.json",
    "check": "biome check --write . && pnpm lint && pnpm check-types",
    "deps": "pnpm dlx taze@latest -Ilw",
    "deps:major": "pnpm dlx taze@latest major -Ilw"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "workerd"
    ]
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@resvg/resvg-wasm": "2.6.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "25.8.4",
    "react": "19.1.0",
    "react-aria-components": "1.15.0",
    "react-dom": "19.1.0",
    "react-i18next": "15.7.4",
    "shadcn": "^4.10.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@cloudflare/workers-types": "4.20260606.1",
    "@fontsource-variable/albert-sans": "5.2.8",
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@fontsource-variable/noto-sans-tc": "^5.2.10",
    "@tailwindcss/postcss": "4.1.18",
    "@tanstack/react-router": "1.168.22",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/router-vite-plugin": "1.166.37",
    "@types/node": "24.10.11",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "8.0.8",
    "wrangler": "4.98.0"
  }
}
